{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketwiki-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "educated.space/pocketwiki*",
      "zone_name": "educated.space"
    }
  ]
}
